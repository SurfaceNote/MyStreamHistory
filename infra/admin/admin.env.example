# Copy to admin.env. Single quotes preserve the dollar signs in the password hash.
AdminAuth__Username=
AdminAuth__PasswordHash=''
AdminServiceAuth__Key=
Services__Gateway=https://api.mystreamhistory.com
Services__Content=https://api.mystreamhistory.com
Metrics__Token=
Monitoring__SentryUrl=
